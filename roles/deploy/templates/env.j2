# Fichier genere par Ansible -- NE PAS editer a la main.
# Les secrets viennent de group_vars/all/vault.yml

# --- MOT DE PASSE ROOT ---
MYSQL_ROOT_PASSWORD={{ mysql_root_password }}

# --- UTILISATEUR & MOT DE PASSE PRINCIPAL ---
MYSQL_USER={{ mysql_user }}
MYSQL_PASSWORD={{ mysql_password }}
MYSQL_DATABASE={{ mysql_database }}

# --- LIEN WORDPRESS ---
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME={{ mysql_database }}
WORDPRESS_DB_USER={{ mysql_user }}
WORDPRESS_DB_PASSWORD={{ mysql_password }}

# --- DOMAINE (IP publique de l'inventory, ou domain_name si defini) ---
DOMAIN_NAME={{ domain_name | default(ansible_host, true) }}
